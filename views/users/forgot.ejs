<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <h2 class="col-6 offset-3">Reset Password</h2>
    <div class="col-6 offset-3">
        <form action="/forgot-password" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="email" class="form-label">Registered Email ID</label>
                <input id="email" type="email" name="email" class="form-control" required>
                <div class="invalid-feedback">Please enter your registered email.</div>
            </div>
            <button class="btn btn-primary">Send Reset Link</button>
        </form>
    </div>
</div>