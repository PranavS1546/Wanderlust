<% layout("/layouts/boilerplate") %>

<div id="filters">
  <div class="filter">
    <a href="/listing" class="filter-link">
   <div><i class="fa-solid fa-fire"></i></div> 
    <p>Trending</p>
  </a>
  </div>
  <div class="filter <%= (typeof category !== 'undefined' && category === 'Rooms') ? 'active' : '' %>">    <a href="/listing/category/Rooms" class="filter-link">
   <div><i class="fa-solid fa-bed"></i></div> 
    <p>Rooms</p></a>
  </div>
  <div class="filter <%= (typeof category !== 'undefined' && category === 'Iconic Cities') ? 'active' : '' %>">    <a href="/listing/category/Rooms" class="filter-link">
    <a href="/listing/category/Iconic Cities" class="filter-link">
   <div><i class="fa-solid fa-city"></i></div> 
    <p>Iconic Cities</p>
  </a>
  </div>
  <div class="filter <%= (typeof category !== 'undefined' && category === 'Mountains') ? 'active' : '' %>">    <a href="/listing/category/Rooms" class="filter-link">
    <a href="/listing/category/Mountains" class="filter-link">
   <div><i class="fa-solid fa-mountain"></i></div> 
    <p>Mountains</p>
  </a>
  </div>
  <div class="filter <%= (typeof category !== 'undefined' && category === 'Castles') ? 'active' : '' %>">    <a href="/listing/category/Rooms" class="filter-link">
    <a href="/listing/category/Castles" class="filter-link">
   <div><i class="fa-brands fa-fort-awesome"></i></div> 
    <p>castles</p>
  </a>
  </div>
  <div class="filter <%= (typeof category !== 'undefined' && category === 'Amazing Pools') ? 'active' : '' %>">    <a href="/listing/category/Rooms" class="filter-link">
    <a href="/listing/category/Amazing Pools" class="filter-link">
   <div><i class="fa-solid fa-person-swimming"></i></div> 
    <p>Amazing Pools</p>
  </a>
  </div>
  <div class="filter <%= (typeof category !== 'undefined' && category === 'Camping') ? 'active' : '' %>">    <a href="/listing/category/Rooms" class="filter-link">
    <a href="/listing/category/Camping" class="filter-link">
    <div><i class="fa-solid fa-mountain"></i></div> 
     <p>Camping</p></a>
   </div>
   <div class="filter <%= (typeof category !== 'undefined' && category === 'Farms') ? 'active' : '' %>">    <a href="/listing/category/Rooms" class="filter-link">
    <a href="/listing/category/Farms" class="filter-link">
    <div><i class="fa-solid fa-tractor"></i></div> 
     <p>Farms</p></a>
   </div>
   <div class="filter <%= (typeof category !== 'undefined' && category === 'Arctic') ? 'active' : '' %>">    <a href="/listing/category/Rooms" class="filter-link">
    <a href="/listing/category/Arctic" class="filter-link">
    <div><i class="fa-solid fa-snowflake"></i></div> 
     <p>Arctic</p></a>
   </div>
   <div class="filter <%= (typeof category !== 'undefined' && category === 'Beach') ? 'active' : '' %>">    <a href="/listing/category/Rooms" class="filter-link">
    <a href="/listing/category/Beach" class="filter-link">
    <div><i class="fa-solid fa-umbrella-beach"></i></div> 
     <p>Beach</p></a>
   </div>
   <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
      <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
    </div>
    
   </div>
</div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
  <% for(let listing of alllisting){ %> 
    <a href="/listing/<%= listing._id %>" class="listing-link">
      <div class="card listing-card">
        <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem;">
        <div class="card-body">
          <p class="card-text">
            <b><%= listing.title %></b> <br>
            &#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : '0' %> / night [cite: 13]
          </p>
        </div>
      </div>
    </a>
  <% } %> 
</div>



<script>
  let taxSwitch = document.getElementById("switchCheckDefault")
  taxSwitch.addEventListener("click",()=>{
  let taxInfo=document.getElementsByClassName("tax-info")

  for(info of taxInfo){
    if(info.style.display !="inline"){
    info.style.display="inline"
    }else{
      info.style.display="none"
    }
  }
  })
</script>    
  